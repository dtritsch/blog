body {
  font-family: 'Noto Sans', sans-serif;
  font-size: 18px;
  line-height: 1.6;
  color: #333333;
  background-color: #fafafa;
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
}

h1, h2, h3, h4, h5, h6 {
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  color: #111111;
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
}

h1 { font-size: 2.5rem; }
h2 { font-size: 2rem; }

header {
  border-bottom: 2px solid #333333;
  margin-bottom: 1.5rem;
}

header > a.site-logo > img {
    width: 250px;
}

nav {
    margin-top: 1rem;
    margin-bottom: 1rem;
}

nav a {
  margin-right: 1rem;
  color: #0056b3;
  text-decoration: none;
  font-weight: 700;
}

nav a:hover {
  /* text-decoration: underline; */
  opacity: 0.8;
}

footer {
  margin-top: 50px;
  padding-top: 20px;
  border-top: 1px solid #eaeaea;
  font-size: 0.9rem;
  color: #666666;
